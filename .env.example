# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development, and add the same values
# in Vercel -> Project -> Settings -> Environment Variables for production.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="banodigitalhub"

# Password you type on /admin
ADMIN_PASSWORD="change-this-to-a-strong-password"
# Random string used to sign the admin session cookie (any long random text)
ADMIN_SESSION_SECRET="change-this-to-a-long-random-string"

# Gmail SMTP. GMAIL_APP_PASSWORD must be a Google App Password
# (https://myaccount.google.com/apppasswords), not the account password -
# Google blocks plain-password SMTP.
GMAIL_USER="banodigitalhub@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# The From header shown to the student.
MAIL_FROM="Bano Digital Hub <banodigitalhub@gmail.com>"
# Where the "new application" notification is sent
ADMIN_EMAIL="banodigitalhub@gmail.com"

# Public site URL - every link inside an email, the canonical tags, robots.txt
# and the sitemap are built from it. Keep it on the live domain even in
# .env.local: a localhost value is ignored on purpose (see lib/site.js) so a
# test submission can never mail a student a dead http://localhost link.
NEXT_PUBLIC_SITE_URL="https://www.banodigitalhub.pk"
